# Server only. Copy these names into .local.env and fill in your own keys.
TOKENOMIST_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
# Optional. Empty values select two available account voices automatically.
ELEVENLABS_BULL_VOICE_ID=
ELEVENLABS_BEAR_VOICE_ID=
# Separate key with ElevenLabs Agents access. Gemini only; backup models disabled.
ELEVENLABS_AGENTS_API_KEY=
ELEVENLABS_AGENTS_MODEL=gemini-2.5-flash
ELEVENLABS_BULL_AGENT_ID=
ELEVENLABS_BEAR_AGENT_ID=
