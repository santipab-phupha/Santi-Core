# Server only. Copy these names into .local.env and fill in your own keys.
TOKENOMIST_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
# Optional. Empty values select two available account voices automatically.
ELEVENLABS_BULL_VOICE_ID=
ELEVENLABS_BEAR_VOICE_ID=
# Separate key with ElevenLabs Agents access. Gemini only; backup models disabled.
ELEVENLABS_AGENTS_API_KEY=
ELEVENLABS_AGENTS_MODEL=gemini-2.5-flash
ELEVENLABS_BULL_AGENT_ID=
ELEVENLABS_BEAR_AGENT_ID=
# Conversational Research, created by scripts/setup-local-research-agent.mts.
ELEVENLABS_RESEARCH_AGENT_ID=
# Impact Reviewer: 1-3 simultaneous tasks, 1-8 news items per task.
# Existing cached item verdicts are reused. These limits apply per server process.
IMPACT_REVIEW_CONCURRENCY=3
IMPACT_REVIEW_BATCH_SIZE=4
# Local impact-only analyst, created by scripts/setup-local-impact-analyst.mts.
ELEVENLABS_IMPACT_AGENT_ID=
# Apply a changed thinking budget to the dedicated local agent using setup with --update-local.
IMPACT_ANALYSIS_THINKING_BUDGET=1024
# Original-link HTTP/text matching; these workers do not invoke an LLM.
REFERENCE_CHECK_CONCURRENCY=6
REFERENCE_CHECK_TIMEOUT_MS=6000
# Opt-in local Vite worker: check all pending sources, then scan for new items.
# HTTP/text matching only; no full-feed AI inference. Disabled on Vercel.
LOCAL_SOURCE_REVIEW_ENABLED=false
