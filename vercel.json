{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/workspace.ts": {
      "maxDuration": 300,
      "supportsCancellation": true
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/workspace"
    }
  ]
}
